export type SmallOscillationParameters = { A: number; g: number };
export type SmallOscillationBranch = "exact" | "within" | "potential-only" | "outside";
export type SmallOscillationLimit = { min: number; max: number; step: number };
export const SMALL_OSC_LIMITS: { A: SmallOscillationLimit; g: SmallOscillationLimit };
export const SMALL_OSC_THRESHOLD: number;
export const SMALL_OSC_PRESETS: (SmallOscillationParameters & { label: string })[];
export function potential(q: number, g: number): number;
export function harmonicPotential(q: number): number;
export function force(q: number, g: number): number;
export function harmonicForce(q: number): number;
export function quantize(value: number, limit: SmallOscillationLimit): number;
export function shiftParameter(name: "A" | "g", value: number, direction: number): number;
export function smallOscillationState(p: SmallOscillationParameters): {
  A: number;
  g: number;
  xDomain: [number, number];
  potentialDomain: [number, number];
  forceDomain: [number, number];
  correctionXDomain: [number, number];
  correctionDomain: [number, number];
  turningPotential: number;
  harmonicTurning: number;
  turningForce: number;
  harmonicForceAtTurning: number;
  correctionPotential: number;
  correctionForce: number;
  threshold: number;
  branch: SmallOscillationBranch;
  potential: (q: number) => number;
  harmonicPotential: (q: number) => number;
  force: (q: number) => number;
  harmonicForce: (q: number) => number;
  correctionPotentialAt: (a: number) => number;
  correctionForceAt: (a: number) => number;
};
